{
  "name": "@his/cli",
  "version": "0.1.0",
  "type": "module",
  "publishConfig": {
    "name": "@noy4/his",
    "access": "public"
  },
  "bin": {
    "his": "./dist/bin.mjs"
  },
  "engines": {
    "node": ">=22.22.3"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm -C ../webui run build && node build.mjs",
    "test:pack": "pnpm run build && node --test test/pack.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "his": "node bin.ts"
  },
  "devDependencies": {
    "@his/core": "workspace:*",
    "@his/server": "workspace:*",
    "@types/node": "^24.13.3",
    "cac": "^7.0.0",
    "oxlint": "^1.81.0",
    "tsdown": "^0.23.2",
    "typescript": "~6.0.2"
  }
}
