{
  "name": "@his/desktop",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "main": "dist/main.js",
  "dependencies": {
    "@his/core": "workspace:*"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/main.js",
    "start": "electron .",
    "dev": "pnpm build && pnpm start",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "electron": "^40.0.0",
    "esbuild": "^0.27.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2"
  }
}
