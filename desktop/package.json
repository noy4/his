{
  "name": "@his/desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/main.js",
  "dependencies": {
    "@his/core": "workspace:*"
  },
  "scripts": {
    "build": "vite build",
    "package:mac": "pnpm -C ../cli run build && pnpm run build && node package.mjs",
    "test:package": "node --test test/package.test.mjs",
    "start": "electron .",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "node --experimental-test-module-mocks --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.13.3",
    "electron": "^40.0.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2"
  }
}
